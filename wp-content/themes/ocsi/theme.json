{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1184px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "red", "color": "#C62828", "name": "Red" },
				{ "slug": "deep-red", "color": "#A20513", "name": "Deep Red" },
				{ "slug": "blue", "color": "#315EA0", "name": "Blue" },
				{ "slug": "paper", "color": "#F7F8FA", "name": "Cool Off-White" },
				{ "slug": "ink", "color": "#161C24", "name": "Ink" },
				{ "slug": "slate", "color": "#64748B", "name": "Slate" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "ice", "color": "#EEF4FF", "name": "Ice" },
				{ "slug": "blush", "color": "#FFDAD6", "name": "Blush" },
				{ "slug": "footer", "color": "#2B3139", "name": "Footer" }
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "\"Inter\", \"Segoe UI\", sans-serif"
				},
				{
					"slug": "display",
					"name": "Plus Jakarta Sans",
					"fontFamily": "\"Plus Jakarta Sans\", \"Segoe UI\", sans-serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#F7F8FA",
			"text": "#161C24"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": { "text": "#315EA0" }
			},
			"button": {
				"color": {
					"background": "#C62828",
					"text": "#FFFFFF"
				},
				"border": { "radius": "4px" }
			}
		}
	}
}
